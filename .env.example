# WaveGuid Invoices — environment variables
#
# --- LOCAL DEV (SQLite file) ---
DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-only-change-me-in-production"

# --- PRODUCTION (Vercel + Turso) ---
# 1. Create a free Turso DB:
#       turso db create waveguid
#       turso db tokens create waveguid        # -> TURSO_AUTH_TOKEN
#       turso db show waveguid --url           # -> DATABASE_URL (libsql://...)
# 2. In Vercel → Project → Settings → Environment Variables, set:
#       DATABASE_URL      = libsql://<your-db>.turso.io
#       TURSO_AUTH_TOKEN  = <token from above>
#       JWT_SECRET        = <a long random string>
# 3. Apply schema + seed once (run locally against the remote DB):
#       $env:DATABASE_URL="libsql://<your-db>.turso.io"
#       $env:TURSO_AUTH_TOKEN="<token>"
#       npm run db:push
#       npm run db:seed
#
# TURSO_AUTH_TOKEN is only required when DATABASE_URL starts with libsql://
# TURSO_AUTH_TOKEN=""

# --- WHATSAPP (Meta Cloud API — automatic invoice PDF sending) ---
# 1. business.facebook.com -> create a Meta Business Account
# 2. developers.facebook.com -> create an app (type: Business) -> add "WhatsApp" product
# 3. Add a WhatsApp Business phone number, then copy:
#       WHATSAPP_PHONE_NUMBER_ID  (WhatsApp -> API Setup -> Phone number ID)
#       WHATSAPP_TOKEN            (System user permanent token with whatsapp_business_messaging + whatsapp_business_messaging media perms)
# 4. Create + submit for approval a message TEMPLATE named "invoice_send" (Account Tools -> Message Templates):
#       - Header: Document
#       - Body: 3 variables, e.g. "Your invoice {{1}} for {{2}} is attached. Due date: {{3}}."
#       - Category: Utility (or Transactional)
#    Send fails until Meta approves it.
# 5. Requires Node 18+ (global fetch/FormData). Free tier: ~1000 conversations/month.
#
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TEMPLATE="invoice_send"
# WHATSAPP_TEMPLATE_LANG="en"
# WHATSAPP_API_VERSION="v21.0"

# --- EMAIL (SMTP — automatic invoice PDF sending to client's email) ---
# Works with any SMTP provider. Examples:
#   Gmail:      SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  (enable 2FA, use an App Password)
#   Outlook:    SMTP_HOST=smtp.office365.com SMTP_PORT=587
#   Brevo:      SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 (free 300/day)
#   Resend:     SMTP_HOST=smtp.resend.com SMTP_PORT=465
# SMTP_SECURE=true means TLS from the start (port 465); port 587 uses STARTTLS.
# EMAIL_FROM is optional — defaults to SMTP_USER. Must be a real address
# allowed by your provider, otherwise delivery fails or lands in spam.
#
# SMTP_HOST=""
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM=""
